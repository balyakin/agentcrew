[2.275717, "o", "$ agentcrew --lang ru --help\r\n"]
[2.374598, "o", "Использование: agentcrew [-h] [--version] [--lang {en,ru}]\r\n                 {doctor,init,develop,new,review,fix,status,report,plan,diff,finding,confirm,answer,apply,attach,pause,resume,cancel,recover,cleanup,export,send,tui,team,queue}\r\n                 ...\r\n"]
[2.375396, "o", "\r\nКоманды агентов для проверяемой разработки в tmux\r\n\r\nПозиционные аргументы:\r\n  {doctor,init,develop,new,review,fix,status,report,plan,diff,finding,confirm,answer,apply,attach,pause,resume,cancel,recover,cleanup,export,send,tui,team,queue}\r\n    doctor              Проверить окружение; вызов модели только с --smoke\r\n    init                Создать настройки репозитория без запуска кода\r\n    develop             Выполнить задачу на разработку\r\n    new                 Создать проект и выполнить задачу\r\n    review              Проверить зафиксированное изменение Git\r\n    fix                 Исправить находку в отдельном дочернем запуске\r\n    status              Показать текущие запуски и команды\r\n    report              Показать отчёт\r\n    plan                Показать план\r\n    diff                Показать патч\r\n    finding             Изучить находку или записать решение\r\n    confirm             Записать ручную проверку критерия этого кандидата\r\n    answer              Ответить на сохранённый вопрос планировщика\r\n    apply               Применить патч кандидата без коммита\r\n    attach              Подключиться к панели агента\r\n    pause               Приостановить запуск\r\n    resume              Продолжить запуск\r\n    cancel              Отменить запуск\r\n    recover             Изучить состояние перед восстановлением процессов\r\n    cleanup             Просмотреть и удалить только свои чистые завершённые\r\n                        копии\r\n    export              Экспортировать отчёт с явным скрытием данных\r\n    send                Сохранить адресное информационное сообщение\r\n    tui                 Панель с клавиатурным управлением; выход сохраняет\r\n                        агентов\r\n    team                Постоянные команды\r\n    queue               Долговечная очередь с владельцами заданий\r\n\r\nПараметры:\r\n  -h, --help            показать справку и выйти\r\n  --version             показать версию и выйти\r\n  --lang {en,ru}\r\n"]
[2.889363, "o", "$\r\n"]
